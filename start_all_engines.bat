@echo off
REM start_all_engines.bat - start all 21 engines, each minimized, logging to axis-bridge\logs\engine_<name>.log
for %%I in ("%~dp0.") do set "ROOT=%%~fI"
start "ENGINE axis-cloud" /min cmd /c "call "%ROOT%\start_engine.bat" axis-cloud >> "%ROOT%\logs\engine_axis-cloud.log" 2>&1"
start "ENGINE axis-core" /min cmd /c "call "%ROOT%\start_engine.bat" axis-core >> "%ROOT%\logs\engine_axis-core.log" 2>&1"
start "ENGINE axis-curator" /min cmd /c "call "%ROOT%\start_engine.bat" axis-curator >> "%ROOT%\logs\engine_axis-curator.log" 2>&1"
start "ENGINE axis-diagnostic" /min cmd /c "call "%ROOT%\start_engine.bat" axis-diagnostic >> "%ROOT%\logs\engine_axis-diagnostic.log" 2>&1"
start "ENGINE axis-drive" /min cmd /c "call "%ROOT%\start_engine.bat" axis-drive >> "%ROOT%\logs\engine_axis-drive.log" 2>&1"
start "ENGINE axis-integrity" /min cmd /c "call "%ROOT%\start_engine.bat" axis-integrity >> "%ROOT%\logs\engine_axis-integrity.log" 2>&1"
start "ENGINE axis-link" /min cmd /c "call "%ROOT%\start_engine.bat" axis-link >> "%ROOT%\logs\engine_axis-link.log" 2>&1"
start "ENGINE axis-llm" /min cmd /c "call "%ROOT%\start_engine.bat" axis-llm >> "%ROOT%\logs\engine_axis-llm.log" 2>&1"
start "ENGINE axis-logic" /min cmd /c "call "%ROOT%\start_engine.bat" axis-logic >> "%ROOT%\logs\engine_axis-logic.log" 2>&1"
start "ENGINE axis-omni" /min cmd /c "call "%ROOT%\start_engine.bat" axis-omni >> "%ROOT%\logs\engine_axis-omni.log" 2>&1"
start "ENGINE axis-phonetic" /min cmd /c "call "%ROOT%\start_engine.bat" axis-phonetic >> "%ROOT%\logs\engine_axis-phonetic.log" 2>&1"
start "ENGINE axis-port" /min cmd /c "call "%ROOT%\start_engine.bat" axis-port >> "%ROOT%\logs\engine_axis-port.log" 2>&1"
start "ENGINE axis-SandM" /min cmd /c "call "%ROOT%\start_engine.bat" axis-SandM >> "%ROOT%\logs\engine_axis-SandM.log" 2>&1"
start "ENGINE axis-search_engine" /min cmd /c "call "%ROOT%\start_engine.bat" axis-search_engine >> "%ROOT%\logs\engine_axis-search_engine.log" 2>&1"
start "ENGINE axis-sweep" /min cmd /c "call "%ROOT%\start_engine.bat" axis-sweep >> "%ROOT%\logs\engine_axis-sweep.log" 2>&1"
start "ENGINE axis-triage" /min cmd /c "call "%ROOT%\start_engine.bat" axis-triage >> "%ROOT%\logs\engine_axis-triage.log" 2>&1"
start "ENGINE axis-validator" /min cmd /c "call "%ROOT%\start_engine.bat" axis-validator >> "%ROOT%\logs\engine_axis-validator.log" 2>&1"
start "ENGINE axis-vantage_point" /min cmd /c "call "%ROOT%\start_engine.bat" axis-vantage_point >> "%ROOT%\logs\engine_axis-vantage_point.log" 2>&1"
start "ENGINE axis-video_creator" /min cmd /c "call "%ROOT%\start_engine.bat" axis-video_creator >> "%ROOT%\logs\engine_axis-video_creator.log" 2>&1"
start "ENGINE axis-vision" /min cmd /c "call "%ROOT%\start_engine.bat" axis-vision >> "%ROOT%\logs\engine_axis-vision.log" 2>&1"
start "ENGINE render" /min cmd /c "call "%ROOT%\start_engine.bat" render >> "%ROOT%\logs\engine_render.log" 2>&1"
echo Started 21 engines. Give them ~15 seconds, then check /api/mesh/telemetry.
